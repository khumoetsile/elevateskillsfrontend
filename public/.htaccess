RewriteEngine On

# /backend is the Node.js API — do not send those requests to Angular.
RewriteCond %{REQUEST_URI} !^/backend

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# index.html has a fixed filename but its content (and the hashed bundle
# names it points to) changes on every deploy — it must always be
# revalidated, or returning visitors keep loading a stale build until a
# hard reload.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # JS/CSS chunk filenames carry a content hash (e.g. main-Q7F6JZXM.js), so a
  # new build always ships new filenames — safe to cache indefinitely.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed static assets (icons, images) change rarely — cache briefly.
  <FilesMatch "\.(ico|png|jpg|jpeg|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
